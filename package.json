{
  "name": "var",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "node scripts/expo-dev.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/expo-dev.cjs",
    "web:lan": "node scripts/expo-dev.cjs --host lan",
    "build": "node scripts/build-vercel.cjs",
    "vercel-build": "node scripts/build-vercel.cjs",
    "admin:dev": "npm --prefix admin-web run dev",
    "admin:build": "npm --prefix admin-web run build",
    "dev:api": "node scripts/ensure-dist-placeholder.cjs && npx vercel dev --listen 3000 --yes --prebuilt --project var",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "appwrite": "^25.0.0",
    "node-appwrite": "^19.1.0",
    "expo": "~55.0.20",
    "expo-blur": "~55.0.14",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-local-authentication": "~55.0.13",
    "expo-notifications": "^0.29.14",
    "expo-status-bar": "~55.0.5",
    "nativewind": "^4.2.3",
    "passkit-generator": "^3.5.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-appwrite": "^0.29.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  }
}
