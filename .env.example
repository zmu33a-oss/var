EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# من Appwrite Console → Project Settings → General → Project ID
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_PROJECT_NAME=var
EXPO_PUBLIC_APPWRITE_PLATFORM=com.xtik.webplus

EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_database_id

EXPO_PUBLIC_APPWRITE_POSTS_COLLECTION_ID=your_posts_collection_id
EXPO_PUBLIC_APPWRITE_PREDICTIONS_COLLECTION_ID=your_predictions_collection_id
EXPO_PUBLIC_APPWRITE_POINTS_COLLECTION_ID=your_points_collection_id
# Required for private messages, follow, likes, and social sync
EXPO_PUBLIC_APPWRITE_SOCIAL_INTERACTIONS_COLLECTION_ID=your_social_interactions_collection_id

# Recommended for profile cards in X feed
EXPO_PUBLIC_APPWRITE_PROFILES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_COMMENTS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_LIKES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_SHARES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_PROFILE_IMAGES_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_VAR_LIBRARY_COLLECTION_ID=var_library

# Moderation reports queue (required for admin reports center)
EXPO_PUBLIC_APPWRITE_REPORTS_COLLECTION_ID=reports
APPWRITE_REPORTS_COLLECTION_ID=reports

# Admin audit log (required for admin action history)
EXPO_PUBLIC_APPWRITE_AUDIT_COLLECTION_ID=admin_audit
APPWRITE_AUDIT_COLLECTION_ID=admin_audit

# Admin access keys (Section 4)
EXPO_PUBLIC_APPWRITE_ADMIN_KEYS_COLLECTION_ID=admin_keys
APPWRITE_ADMIN_KEYS_COLLECTION_ID=admin_keys

# Global app UI mode (X / TikTok) — Section 4
EXPO_PUBLIC_APPWRITE_APP_SETTINGS_COLLECTION_ID=app_settings
APPWRITE_APP_SETTINGS_COLLECTION_ID=app_settings
# Optional post moderation fields for AI: moderationStatus, aiScore, aiFlags, reportCount

# AI auto-moderation (Section 3)
AI_MODERATION_ENABLED=true
AI_MODERATION_THRESHOLD=70
AI_MODERATION_AUTO_HIDE_THRESHOLD=92
AI_MODERATION_WEBHOOK_SECRET=change-me-to-random-secret
# AI_MODERATION_KEYWORDS=spam,احتيال,مجاني

# Admin account (Appwrite login email)
EXPO_PUBLIC_VAR_ADMIN_EMAIL=zmu33a@gmail.com
VAR_ADMIN_EMAIL=zmu33a@gmail.com

# Optional: full URL to admin panel (defaults to /admin/ on same host)
EXPO_PUBLIC_ADMIN_PANEL_URL=

# WhatsApp for profile quick-support slide (digits only, e.g. 9665xxxxxxxx)
EXPO_PUBLIC_VAR_SUPPORT_WHATSAPP=

# Admin API for mobile dashboard commands (defaults to :3000 when Expo web runs on :8081)
EXPO_PUBLIC_ADMIN_API_URL=http://localhost:3000

# Server-side only — required for admin commands (users list, verify, suspend, hide posts)
APPWRITE_API_KEY=