EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
# من Appwrite Console → Project Settings → General → Project ID
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_PROJECT_NAME=var
EXPO_PUBLIC_APPWRITE_PLATFORM=com.xtik.webplus

EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_database_id

EXPO_PUBLIC_APPWRITE_POSTS_COLLECTION_ID=your_posts_collection_id
EXPO_PUBLIC_APPWRITE_PREDICTIONS_COLLECTION_ID=your_predictions_collection_id
EXPO_PUBLIC_APPWRITE_POINTS_COLLECTION_ID=your_points_collection_id
# Required for private messages, follow, likes, and social sync
EXPO_PUBLIC_APPWRITE_SOCIAL_INTERACTIONS_COLLECTION_ID=your_social_interactions_collection_id

# Recommended for profile cards in X feed
EXPO_PUBLIC_APPWRITE_PROFILES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_COMMENTS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_LIKES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_SHARES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_PROFILE_IMAGES_BUCKET_ID=

# Optional admin reservation
EXPO_PUBLIC_VAR_ADMIN_EMAIL=